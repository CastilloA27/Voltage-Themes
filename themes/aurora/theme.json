{
  "$schema": "https://raw.githubusercontent.com/CastilloA27/Voltage-Plugins/main/themes/theme.schema.json",
  "id": "aurora",
  "name": "Aurora",
  "version": "1.0.0",
  "author": "Voltage",
  "extends": "voltage",
  "appearance": "dark",
  "minVoltage": "1.7.2",
  "description": "Northern lights in the album's colours over a black sky, a different sky for every song, swaying with the music. The player floats at the bottom so the sky has the window. Needs the \"Aurora sky\" plugin for the lights (graphics card, 30 fps while playing).",
  "plugin": "aurora-sky",
  "uses": [
    "level"
  ],
  "tokens": {
    "color.bg": "#000000",
    "color.surface": "rgba(0, 0, 0, .28)",
    "color.border": "rgba(255, 255, 255, .08)",
    "effect.blur": "14px",
    "effect.glow-size": "18px",
    "effect.glow-alpha": "35%",
    "accent.album-mix": "1",
    "shape.radius": "18px"
  },
  "supports": {
    "background": [
      "black"
    ]
  },
  "strings": {
    "nowplaying.idle": "Clear skies",
    "tab.queue": "Up next"
  },
  "layout": {
    "home": {
      "areas": [
        "art info side",
        "sky sky side",
        "prog prog side",
        "bar bar bar"
      ],
      "columns": "88px minmax(0, 1fr) minmax(240px, 320px)",
      "rows": "88px minmax(0, 1fr) 40px 76px",
      "place": {
        "art": "art",
        "info": "info",
        "side": "sidebar",
        "prog": "progress",
        "bar": "player"
      },
      "resizable": [
        "side"
      ]
    }
  },
  "css": "theme.css"
}
